# Database
DATABASE_URL="postgresql://user:password@localhost:5432/codeme"

# NextAuth.js
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Providers (CodeMe AI works with any of these - app works in demo mode without any)
OPENAI_API_KEY="sk-your-openai-api-key"
ANTHROPIC_API_KEY="sk-your-anthropic-api-key"
GOOGLE_API_KEY="your-google-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
PERPLEXITY_API_KEY="pplx-your-perplexity-api-key"
QWEN_API_KEY="your-qwen-api-key"

# GitHub Copilot Pro (optional - for Copilot integration)
GITHUB_COPILOT_TOKEN="your-github-copilot-token"

# Figma (optional - for Figma to Code feature)
FIGMA_ACCESS_TOKEN="your-figma-access-token"

# Deployment Providers (optional - for one-click deployment)
# AWS
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# Google Cloud
GCP_SERVICE_ACCOUNT_KEY="your-gcp-service-account-json"

# cPanel/DirectAdmin
CPANEL_HOST="your-cpanel-host"
CPANEL_USERNAME="your-cpanel-username"
CPANEL_API_TOKEN="your-cpanel-api-token"

DIRECTADMIN_HOST="your-directadmin-host"
DIRECTADMIN_USERNAME="your-directadmin-username"
DIRECTADMIN_API_KEY="your-directadmin-api-key"

# Vercel
VERCEL_TOKEN="your-vercel-token"

# Netlify
NETLIFY_TOKEN="your-netlify-token"

# Railway
RAILWAY_TOKEN="your-railway-token"

# DigitalOcean
DIGITALOCEAN_TOKEN="your-digitalocean-token"
